{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joiask-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "secrets": { "required": ["SESSION_SECRET", "SETTINGS_KEY"] },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "run_worker_first": ["/api/*", "/upload-img/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "joiask-db", "migrations_dir": "migrations","database_id": "238aff06-fa24-4db1-8dc4-2db2948a881d" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "joiask-files","preview_bucket_name": "joiask-files" }],
  "durable_objects": { "bindings": [{ "name": "REALTIME", "class_name": "Realtime" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Realtime"] }],
  "queues": {
    "producers": [{ "binding": "MODERATION", "queue": "joiask-moderation" }],
    "consumers": [{ "queue": "joiask-moderation", "max_batch_size": 5, "max_retries": 3, "max_batch_timeout": 5 }]
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
